{
  "name": "poketactics",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test:touch": "node scripts/touch-check.mjs",
    "test": "node --experimental-strip-types --test src/engine.test.ts src/effects.test.ts src/battle.test.ts src/traits.test.ts src/balance.test.ts src/sandbox.test.ts src/damage.test.ts src/mana.test.ts src/mixed.test.ts src/facing.test.ts src/progression.test.ts src/lobby.test.ts src/items.test.ts src/gestures.test.ts src/inspection.test.ts src/feedback.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "balance": "node --experimental-strip-types scripts/balance.ts",
    "audit:damage": "node --experimental-strip-types scripts/damage-audit.ts",
    "audit:run": "node --experimental-strip-types scripts/run-audit.ts",
    "audit:formations": "node --experimental-strip-types scripts/formation-counters.ts",
    "audit:mixed": "node --experimental-strip-types scripts/mixed-audit.ts",
    "publish:github": "node scripts/publish-github.mjs"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "engines": {
    "node": ">=24"
  }
}
